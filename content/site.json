        },
        {
          "type": "row",
          "valign": "center",
          "items": [
            {
              "type": "stack",
              "flex": 9,
              "items": [
                {
                  "type": "text",
                  "html": "<h2>Retro Plane Animation</h2><div>A looping synthwave-style flight over a low-poly neon landscape toward a glowing sun. Modeled and animated in Maya, rendered in Blender.</div><ul class=\"tags\"><li>Maya</li><li>Blender</li></ul>"
                }
              ]
            },
