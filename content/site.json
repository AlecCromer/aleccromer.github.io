                {
                  "type": "text",
                  "html": "<h2>Music Block Animation</h2><div>An animation built with Maya's MASH utilities, where the beat of a song drives the size of the blocks. Modeled and animated in Maya, rendered in Blender.</div><ul class=\"tags\"><li>Maya</li><li>MASH</li><li>Blender</li></ul>"
                }
