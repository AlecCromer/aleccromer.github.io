                }
              ]
            }
          ]
        },
        {
          "type": "row",
          "valign": "center",
          "items": [
            {
              "type": "stack",
              "flex": 9,
              "items": [
                {
                  "type": "text",
                  "html": "<h2>Pangolin Sculpt</h2><div>A digital sculpt of a pangolin, built up scale by scale with detailed claws and skin folds.</div><ul class=\"tags\"><li>ZBrush</li></ul>"
                }
              ]
            },
            {
              "type": "stack",
              "flex": 11,
