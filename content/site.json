      "title": "Misc. Graphics Projects",
      "description": "",
      "modules": [
        {
          "type": "row",
          "valign": "center",
          "items": [
            {
              "type": "stack",
              "flex": 9,
              "items": [
                {
                  "type": "text",
                  "html": "<h2>Three.js Hair Card Simulation Generator Tool</h2><div>Using WebGL and a hair physics simulation, a user can define sliders that will create an image that can be used as a hair card.</div><ul class=\"tags\"><li>Three.js</li><li>WebGL</li></ul>"
                }
              ]
            },
            {
              "type": "stack",
              "flex": 11,
              "items": [
                {
                  "type": "image",
                  "src": "assets/maya-scripts/01.gif",
                  "width": 1920,
                  "ratio": 0.5617,
                  "caption": null
                },
                {
                  "type": "gallery",
                  "items": [
                    {
                      "type": "image",
                      "src": "assets/maya-scripts/02.png",
                      "width": 599,
                      "ratio": 1.0518,
